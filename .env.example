# 이 파일을 .env로 복사한 뒤 값을 채우세요. (.env는 커밋 금지)

# [필수] 세션 서명용 비밀 키. 아래 명령으로 무작위 값 생성:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# HTTPS 배포 시 1로 설정 (쿠키에 Secure 플래그). 로컬 개발은 0.
COOKIE_SECURE=0

# 개발 모드 (1=on). 배포 시 0 권장.
FLASK_DEBUG=1

# 신고 임계치 (상품 차단 / 유저 휴면)
REPORT_THRESHOLD=5

# 가입 시 지급하는 가상 포인트 보너스 (실제 화폐 아님)
SIGNUP_BONUS=10000

# 로그인 시도 제한 (브루트포스 완화): 윈도(초) 내 실패 임계치
LOGIN_MAX_FAILURES=5
LOGIN_FAIL_WINDOW=300
